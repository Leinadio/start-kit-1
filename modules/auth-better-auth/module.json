{
  "name": "auth-better-auth",
  "provides": ["auth", "auth-client"],
  "requires": ["database"],
  "deps": ["better-auth"],
  "env": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "LINKEDIN_CLIENT_ID", "LINKEDIN_CLIENT_SECRET"],
  "files": ["lib/auth/server.ts", "lib/auth/client-adapter.ts", "app/api/auth/[...all]/route.ts", "prisma/schema/auth.prisma"],
  "wiring": [
    {
      "file": "lib/adapters/index.ts",
      "marker": "adapter:auth",
      "type": "replace",
      "import": "import { betterAuthAdapter } from \"@/lib/auth/server\"",
      "installedValue": "  auth: betterAuthAdapter,",
      "defaultValue": "  auth: authStub,"
    },
    {
      "file": "lib/auth/client.ts",
      "marker": "prise:auth-client",
      "type": "replace",
      "installedValue": "export * from \"./client-adapter\"",
      "defaultValue": "export * from \"./client-stub\""
    }
  ]
}
